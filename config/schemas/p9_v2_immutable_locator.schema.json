{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fuse:p9-v2:immutable-locator:2.0.0",
  "title": "P9 v2 immutable external artifact locator",
  "type": "object",
  "required": ["backend", "location", "immutable_object_id", "content_sha256", "byte_size", "role", "media_type"],
  "properties": {
    "backend": {"const": "filesystem"},
    "location": {
      "type": "object",
      "required": ["namespace", "relative_path"],
      "properties": {
        "namespace": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "relative_path": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"}
      },
      "additionalProperties": false
    },
    "immutable_object_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "associated_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "byte_size": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "role": {"enum": ["checkpoint_payload", "checkpoint_manifest"]},
    "media_type": {"type": "string", "minLength": 1, "maxLength": 128}
  },
  "additionalProperties": false
}
