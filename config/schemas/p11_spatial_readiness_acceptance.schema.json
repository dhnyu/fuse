{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fuse.local/schemas/p11_spatial_readiness_acceptance.schema.json",
  "type": "object",
  "required": ["schema_version", "artifact_type", "implementation_version", "implementation_sha256", "dissertation_authority_id", "methodology_id", "downstream_dataset_id", "p10_acceptance_id", "master_fold_id", "master_fold_sha256", "target_fold_sha256", "embedding_binding_id", "embedding_binding_sha256", "leakage_gate_sha256", "oof_readiness_sha256", "fold_count", "scene_count", "target_count", "model_count", "next_work_unit", "ridge_execution_authorized", "readiness_id", "content_sha256", "status", "artifacts"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "p11_spatial_fold_and_leakage_readiness"},
    "implementation_version": {"const": "p11-spatial-readiness-v1"},
    "implementation_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "dissertation_authority_id": {"const": "disauth_febd90b8475a5e9caa9f7d2f"},
    "methodology_id": {"const": "p11meth_6cc844b7f5d1fc896d9e7be2"},
    "downstream_dataset_id": {"const": "p11ds_39607da2de792ad6b3c9bb30"},
    "p10_acceptance_id": {"const": "p10acc_6e5071beee7616750dec7907"},
    "master_fold_id": {"pattern": "^p11fold_[0-9a-f]{24}$"},
    "master_fold_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "target_fold_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "embedding_binding_id": {"pattern": "^p11emb_[0-9a-f]{24}$"},
    "embedding_binding_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "leakage_gate_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "oof_readiness_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "fold_count": {"const": 25},
    "scene_count": {"const": 1600},
    "target_count": {"const": 11},
    "model_count": {"const": 8},
    "next_work_unit": {"const": "P11_E_SPATIAL_RIDGE_PROBES_AND_OOF_PREDICTIONS"},
    "ridge_execution_authorized": {"const": true},
    "readiness_id": {"pattern": "^p11c_[0-9a-f]{24}$"},
    "content_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "status": {"const": "PASS"},
    "artifacts": {"type": "array", "minItems": 5, "maxItems": 5}
  },
  "additionalProperties": false
}
