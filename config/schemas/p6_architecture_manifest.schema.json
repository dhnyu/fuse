{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "status", "model_authority_id", "model_contract_id", "dimensions", "modules", "parameter_counts", "implementation_sha256", "content_sha256"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "status": {"const": "PASS"},
    "model_authority_id": {"pattern": "^dma_[0-9a-f]{24}$"},
    "model_contract_id": {"type": "string"},
    "dimensions": {"type": "object", "required": ["d", "d_c", "attention_heads", "head_dimension", "ffn_dimension"], "properties": {"d": {"const": 128}, "d_c": {"const": 128}, "attention_heads": {"const": 4}, "head_dimension": {"const": 32}, "ffn_dimension": {"const": 256}}},
    "modules": {"type": "object", "required": ["reconstruction_decoders"], "properties": {"reconstruction_decoders": {"const": false}}},
    "parameter_counts": {
      "type": "object",
      "required": ["trainable", "non_trainable", "total", "by_module"]
    },
    "implementation_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "content_sha256": {"pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
