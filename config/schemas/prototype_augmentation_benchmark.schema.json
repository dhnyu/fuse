    "status": {"const": "PASS"},
    "augmentation_acceptance_id": {"type": "string", "pattern": "^paa_[0-9a-f]{24}$"},
    "accepted_dataset_id": {"const": "ptd_cee61a525ca92f1b7951c40d"},
    "dataloader_smoke_id": {"const": "pdl_4037d275d729c82ea9b19d97"},
    "scientific_identity": {"type": "object"},
    "correctness": {"type": "object"},
    "logical_results": {"type": "object"},
    "execution_evidence": {"type": "object"},
    "outputs": {"type": "array", "minItems": 3}
  },
  "additionalProperties": true
}
