{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fuse:p9-v2:draft:acceptance",
  "title": "DRAFT_NON_RUNTIME_NON_AUTHORIZING P9 v2 acceptance",
  "type": "object",
  "required": [
    "schema_version", "artifact_type", "acceptance_id", "status", "authority_hash",
    "run_bundle_id", "run_bundle_hash", "finalization_id", "finalization_result_hash",
    "selected_checkpoint_id", "payload_sha256", "manifest_sha256", "evaluation_consumption_count",
    "provenance_chain", "acceptance_content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0-draft"},
    "artifact_type": {"const": "p9_v2_acceptance"},
    "acceptance_id": {"type": "string", "pattern": "^p9accv2_[0-9a-f]{24}$"},
    "status": {"const": "PASS"},
    "authority_hash": {"$ref": "#/$defs/sha256"},
    "run_bundle_id": {"type": "string", "pattern": "^p9rb_[0-9a-f]{24}$"},
    "run_bundle_hash": {"$ref": "#/$defs/sha256"},
    "finalization_id": {"type": "string", "pattern": "^p9fin_[0-9a-f]{24}$"},
    "finalization_result_hash": {"$ref": "#/$defs/sha256"},
    "selected_checkpoint_id": {"type": "string", "pattern": "^p9ck_[0-9a-f]{24}$"},
    "payload_sha256": {"$ref": "#/$defs/sha256"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "evaluation_consumption_count": {"const": 0},
    "provenance_chain": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "acceptance_content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
  "additionalProperties": false
}
