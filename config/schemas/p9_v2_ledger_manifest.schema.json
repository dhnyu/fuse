{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fuse:p9-v2:ledger-manifest:2.0.0",
  "title": "P9 v2 closed ledger manifest",
  "type": "object",
  "required": ["schema_version", "artifact_type", "run_id", "event_count", "first_sequence", "last_sequence", "tail_event_hash", "segment_policy", "segments"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "artifact_type": {"const": "p9_v2_ledger_manifest"},
    "run_id": {"type": "string", "pattern": "^p9runv2_[0-9a-f]{24}$"},
    "event_count": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "first_sequence": {"const": 1},
    "last_sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "tail_event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "segment_policy": {
      "type": "object",
      "required": ["events_per_segment", "maximum_event_bytes"],
      "properties": {"events_per_segment": {"const": 1}, "maximum_event_bytes": {"const": 1048576}},
      "additionalProperties": false
    },
    "segments": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "first_sequence", "last_sequence", "event_count", "size_bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^segments/[0-9]{12}-[0-9]{12}\\.jsonl$"},
          "first_sequence": {"type": "integer", "minimum": 1}, "last_sequence": {"type": "integer", "minimum": 1},
          "event_count": {"const": 1}, "size_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
