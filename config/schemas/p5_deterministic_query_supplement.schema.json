{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "supplement_id", "authority_id", "augmentation_contract_id", "p3_cache_id", "p3_acceptance_id", "p4_supplement_id", "p4_master_bank_id", "p4_logical_index_id", "p4_accepted_augmenter_sha256", "profile", "namespaces", "query_indices", "seed", "publication"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "supplement_id": {"const": "p5-fixed-query-v2"},
    "authority_id": {"type": "string", "anyOf": [{"pattern": "^mta_"}, {"const": "dynamic_from_reduced_methodology_authority"}]},
    "augmentation_contract_id": {"type": "string", "minLength": 1},
    "p3_cache_id": {"type": "string", "anyOf": [{"pattern": "^oscache_"}, {"const": "dynamic_from_original_scene_dataset_acceptance"}]},
    "p3_acceptance_id": {"type": "string", "anyOf": [{"pattern": "^osca_"}, {"const": "dynamic_from_original_scene_dataset_acceptance"}]},
    "p4_supplement_id": {"const": "p4-augmentation-v2"},
    "p4_master_bank_id": {"type": "string", "anyOf": [{"pattern": "^augbank_"}, {"const": "dynamic_from_augmentation_bank_acceptance"}]},
    "p4_logical_index_id": {"type": "string", "anyOf": [{"pattern": "^abi_"}, {"const": "dynamic_from_effective_augmentation_bank_index"}]},
    "p4_accepted_augmenter_sha256": {"type": "string", "anyOf": [{"pattern": "^[0-9a-f]{64}$"}, {"const": "dynamic_from_augmentation_bank_plan"}]},
    "profile": {"type": "object", "required": ["profile_id"], "properties": {"profile_id": {"const": "main_1.0x"}}},
    "namespaces": {"type": "object", "required": ["validation", "evaluation"]},
    "query_indices": {"const": [0, 1]},
    "seed": {"type": "object", "required": ["root_fields", "operation_substream", "digest_to_rng"]},
    "publication": {"type": "object", "required": ["training_bank_membership", "namespace_isolation", "collision_policy"]}
  },
  "additionalProperties": true
}
