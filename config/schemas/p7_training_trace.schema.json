{
  "$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,
  "required":["schema_version","status","trace_id","run_id","training_authority_id","step_count","epoch_count","steps","validation_events","content_sha256"],
  "properties":{"schema_version":{"const":"1.0.0"},"status":{"const":"PASS"},"trace_id":{"type":"string","pattern":"^p7tr_[0-9a-f]{24}$"},"run_id":{"type":"string"},"training_authority_id":{"type":"string"},"step_count":{"type":"integer","minimum":1,"maximum":1600},"epoch_count":{"type":"integer","minimum":1,"maximum":200},"steps":{"type":"array","minItems":1,"maxItems":1600},"validation_events":{"type":"array","minItems":1,"maxItems":40},"content_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
}
