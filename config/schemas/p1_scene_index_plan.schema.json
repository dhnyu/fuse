{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "plan_id", "status", "methodology_authority_id", "scene_contract_id", "input_inventory_id", "off_grid_source_id", "scientific", "scientific_fingerprint", "execution"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "plan_id": {"type": "string", "pattern": "^rsp_[0-9a-f]{24}$"},
    "status": {"const": "PASS"},
    "methodology_authority_id": {"const": "mta_f90fecff7bc7bb5d231cc79f"},
    "scene_contract_id": {"type": "string"},
    "input_inventory_id": {"type": "string"},
    "off_grid_source_id": {"type": "string"},
    "scientific": {"type": "object"},
    "scientific_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution": {"type": "object"}
  },
  "additionalProperties": false
}
