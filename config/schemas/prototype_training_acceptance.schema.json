{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fuse.local/schemas/prototype-training-acceptance-1.0.0.json",
  "type": "object",
  "required": [
    "schema_version", "status", "training_acceptance_id", "plan_id", "run_id",
    "scientific_identity", "completion", "validation_history", "best_checkpoint",
    "final_checkpoint", "exact_resume", "fresh_process_validation", "resources", "outputs"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "status": {"const": "PASS"},
    "training_acceptance_id": {"type": "string", "pattern": "^pta_[0-9a-f]{24}$"},
    "plan_id": {"const": "ptp_19ce115adab48c4ff737a44d"},
    "run_id": {"const": "ptr_35743175250eaa556102185c"},
    "scientific_identity": {"type": "object"},
    "completion": {
      "type": "object",
      "required": ["epochs_completed", "optimizer_steps", "training_scene_consumptions", "termination"],
      "properties": {
        "epochs_completed": {"type": "integer", "minimum": 1, "maximum": 200},
        "optimizer_steps": {"type": "integer", "minimum": 1, "maximum": 1600},
        "training_scene_consumptions": {"type": "integer", "minimum": 32},
        "termination": {"enum": ["early_stopping", "maximum_epochs"]}
      }
    },
    "validation_history": {
      "type": "array", "minItems": 1, "maxItems": 40,
      "items": {
        "type": "object",
        "required": ["epoch", "MRR", "HIT@1", "HIT@5", "HIT@10", "population", "embedding_digest", "retrieval_digest", "scene_ids_digest"]
      }
    },
    "best_checkpoint": {"$ref": "#/$defs/checkpoint"},
    "final_checkpoint": {"$ref": "#/$defs/checkpoint"},
    "exact_resume": {
      "type": "object",
      "required": ["status", "checkpoint_step", "comparison_steps", "direct_state_digest", "replay_state_digest"],
      "properties": {"status": {"const": "PASS"}}
    },
    "fresh_process_validation": {
      "type": "object", "required": ["status", "mode", "best_epoch", "metrics", "embedding_digest", "retrieval_digest"],
      "properties": {"status": {"const": "PASS"}}
    },
    "resources": {
      "type": "object",
      "required": ["optimizer_step_performed", "world_size", "worker_count", "workers_per_rank"],
      "properties": {
        "optimizer_step_performed": {"const": true},
        "world_size": {"const": 2},
        "worker_count": {"const": 40},
        "workers_per_rank": {"const": 20}
      }
    },
    "outputs": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/output"}}
  },
  "$defs": {
    "checkpoint": {
      "type": "object",
      "required": ["path", "size_bytes", "sha256", "optimizer_step", "scene_consumptions", "epoch", "role"],
      "properties": {
        "path": {"type": "string"}, "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "output": {
      "type": "object", "additionalProperties": false,
      "required": ["relative_path", "size_bytes", "sha256"],
      "properties": {
        "relative_path": {"type": "string"}, "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "additionalProperties": true
}
