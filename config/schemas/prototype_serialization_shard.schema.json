{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fuse.local/schemas/prototype-serialization-shard-1.0.0.json",
  "title": "Prototype serialization shard manifest",
  "type": "object",
  "required": [
    "manifest_schema_version", "status", "plan_id", "serialization_dataset_id",
    "branch_id", "split", "scene_ids", "totals", "tensor_schema_hash",
    "source_spec", "scientific_identity", "outputs", "qc"
  ],
  "properties": {
    "manifest_schema_version": {"const": "1.0.0"},
    "status": {"const": "PASS"},
    "plan_id": {"const": "psp_aa295747ee7814efbd1d177c"},
    "serialization_dataset_id": {"const": "psd_aa295747ee7814efbd1d177c"},
    "branch_id": {"type": "string", "pattern": "^psb_[0-9a-f]{24}$"},
    "split": {"enum": ["training", "validation", "evaluation"]},
    "scene_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "totals": {
      "type": "object",
      "required": ["scene_count", "node_count", "ordered_edge_count", "coordinate_count", "empty_edge_scene_count", "actual_uncompressed_bytes", "archive_bytes"]
    },
    "tensor_schema_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_spec": {"type": "object", "required": ["path", "sha256", "size_bytes"]},
    "scientific_identity": {
      "type": "object",
      "required": ["spatial_dataset_id", "serialization_plan_id", "serialization_dataset_id", "i14_spec_sha256", "tensor_contract_sha256", "manifest_schema_sha256", "implementation_sha256", "requirements_sha256", "serialization_algorithm"]
    },
    "outputs": {"type": "array", "minItems": 5},
    "qc": {"type": "object", "required": ["status", "round_trip_scene_count", "error_count"]}
  },
  "additionalProperties": true
}
