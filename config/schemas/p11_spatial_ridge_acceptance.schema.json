    "p11_c_acceptance_id": {"const": "p11c_e78d7c740edc49f1f646ebc3"},
    "master_fold_id": {"const": "p11fold_48a03eba108b799379891e4c"},
    "embedding_binding_id": {"const": "p11emb_0fe61f9e1dc0faf640084abb"},
    "downstream_dataset_id": {"const": "p11ds_39607da2de792ad6b3c9bb30"},
    "p10_acceptance_id": {"const": "p10acc_6e5071beee7616750dec7907"},
    "model_count": {"const": 8},
    "target_count": {"const": 11},
    "fold_count": {"const": 25},
    "fit_count": {"const": 2200},
