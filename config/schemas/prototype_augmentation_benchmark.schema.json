{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fuse.local/schemas/prototype-augmentation-benchmark-1.0.0.json",
  "title": "Prototype augmentation benchmark manifest",
  "type": "object",
  "required": [
    "schema_version", "status", "augmentation_acceptance_id", "accepted_dataset_id",
    "dataloader_smoke_id", "scientific_identity", "correctness", "logical_results",
