{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "status", "query_authority_id", "plan_id", "supplement_id", "parent_cache_id", "parent_acceptance_id", "branch_count", "scene_count", "query_count", "split_counts", "scientific_fingerprint", "implementation_hash", "branches"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "status": {"const": "PASS"},
    "query_authority_id": {"pattern": "^fqa_[0-9a-f]{24}$"}, "plan_id": {"pattern": "^fqp_[0-9a-f]{24}$"},
    "supplement_id": {"const": "p5-fixed-query-v2"}, "parent_cache_id": {"pattern": "^oscache_[0-9a-f]{24}$"},
    "parent_acceptance_id": {"pattern": "^osca_[0-9a-f]{24}$"},
    "branch_count": {"type": "integer", "minimum": 1}, "scene_count": {"const": 2000}, "query_count": {"const": 4000},
    "split_counts": {"type": "object", "required": ["validation", "evaluation"]},
    "scientific_fingerprint": {"pattern": "^[0-9a-f]{64}$"}, "implementation_hash": {"pattern": "^[0-9a-f]{64}$"},
    "branches": {"type": "array", "minItems": 1}
  }, "additionalProperties": true
}
