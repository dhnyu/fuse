{
  "$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,
  "required":["schema_version","status","selector_id","run_id","best_epoch","best_validation_retrieval_loss","best_validation_margin","patience_events","events","best_checkpoint_id","content_sha256"],
