{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "status", "supplement_id", "query_authority_id", "branch_id", "namespace", "split", "parent_cache_id", "parent_tar_sha256", "scene_ids", "scene_count", "query_count", "payload", "members", "logical_content_sha256", "implementation_hash", "validation"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "status": {"const": "PASS"}, "supplement_id": {"const": "p5-fixed-query-v1"},
    "query_authority_id": {"pattern": "^fqa_[0-9a-f]{24}$"}, "branch_id": {"pattern": "^fqb_[0-9a-f]{24}$"},
    "namespace": {"enum": ["validation-query", "evaluation-query"]}, "split": {"enum": ["validation", "evaluation"]},
    "parent_cache_id": {"const": "oscache_c89fa07e3d6cb1819a7994a6"}, "parent_tar_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "scene_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "scene_count": {"type": "integer", "minimum": 1}, "query_count": {"type": "integer", "minimum": 2},
    "payload": {"type": "object", "required": ["filename", "size_bytes", "sha256"]}, "members": {"type": "array"},
    "logical_content_sha256": {"pattern": "^[0-9a-f]{64}$"}, "implementation_hash": {"pattern": "^[0-9a-f]{64}$"},
    "validation": {"type": "object", "required": ["writer", "schema", "global_invariants"]}
  }, "additionalProperties": true
}
