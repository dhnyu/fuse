{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "scene_index_id", "status", "authority_id", "plan_id", "row_count", "split_counts", "scientific_identity", "scientific_hash", "files"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "scene_index_id": {"type": "string", "pattern": "^rsi_[0-9a-f]{24}$"},
    "status": {"const": "PASS"},
    "authority_id": {"const": "mta_f90fecff7bc7bb5d231cc79f"},
    "plan_id": {"type": "string"},
    "row_count": {"const": 4421},
    "split_counts": {"type": "object"},
    "scientific_identity": {"type": "object"},
    "scientific_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "files": {"type": "array", "minItems": 1}
  },
  "additionalProperties": false
}
