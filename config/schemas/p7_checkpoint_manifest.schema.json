{
  "$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,
  "required":["schema_version","status","checkpoint_id","role","epoch","global_update","state_content_sha256","payload","parents","run_id","training_authority_id"],
