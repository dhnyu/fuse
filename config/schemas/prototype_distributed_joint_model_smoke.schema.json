{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "status", "distributed_joint_acceptance_id", "parent_joint_model_identity", "scientific_identity", "parity", "execution", "outputs"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "status": {"const": "PASS"},
    "distributed_joint_acceptance_id": {"type": "string", "pattern": "^pjd_[0-9a-f]{24}$"},
    "parent_joint_model_identity": {"type": "string", "pattern": "^pjm_[0-9a-f]{24}$"},
    "scientific_identity": {"type": "object"},
    "parity": {"type": "object"},
    "execution": {
      "type": "object",
      "required": ["world_size", "workers_planned", "workers_per_rank", "optimizer_step_performed", "optimizer_steps"],
      "properties": {
        "world_size": {"const": 2},
        "workers_planned": {"const": 40},
        "workers_per_rank": {"const": 20},
        "optimizer_step_performed": {"const": false},
        "optimizer_steps": {"const": 0}
      }
    },
    "outputs": {"type": "array", "minItems": 1}
  },
  "additionalProperties": true
}
