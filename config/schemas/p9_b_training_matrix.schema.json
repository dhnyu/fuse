{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fuse.local/schemas/p9_b_training_matrix.schema.json",
  "type": "object",
  "required": ["schema_version", "artifact_type", "status", "plan_id", "selected_fm_acceptance_id", "count", "evaluation_ancestry", "rows"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "p9_b_training_matrix"},
    "status": {"const": "MATERIALIZED_NOT_EXECUTED"},
    "plan_id": {"pattern": "^p9bplan_[0-9a-f]{24}$"},
    "selected_fm_acceptance_id": {"pattern": "^p9accv2_[0-9a-f]{24}$"},
    "count": {"const": 7},
    "evaluation_ancestry": {"const": false},
    "rows": {
      "type": "array", "minItems": 7, "maxItems": 7,
      "items": {
        "type": "object",
        "required": ["configuration_id", "configuration_family", "model_family", "scientific_hash", "scientific", "bank_binding", "transformation_contract", "selected_fm_acceptance_id", "p9_b_plan_id", "run_seed_configuration_id", "evaluation_query_identity", "evaluation_ancestry"],
        "properties": {
          "configuration_id": {"pattern": "^cmp_[a-z0-9_]+$"},
          "configuration_family": {"const": "comparison"},
          "model_family": {"enum": ["A1", "A2", "A3", "A4", "A5", "SSV", "DS"]},
          "scientific_hash": {"pattern": "^[0-9a-f]{64}$"},
          "scientific": {"type": "object"},
          "bank_binding": {"type": "object"},
          "transformation_contract": {"type": "object"},
          "selected_fm_acceptance_id": {"pattern": "^p9accv2_[0-9a-f]{24}$"},
          "p9_b_plan_id": {"pattern": "^p9bplan_[0-9a-f]{24}$"},
          "run_seed_configuration_id": {"pattern": "^cmp_[a-z0-9_]+$"},
          "evaluation_query_identity": {"type": "null"},
          "evaluation_ancestry": {"const": false}
        }
      }
    }
  },
  "additionalProperties": false
}
